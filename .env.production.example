# Public application and approved Moodle origin
NEXT_PUBLIC_APP_BASE_URL=https://fyec100-assistant.example.edu
MOODLE_ORIGIN=https://moodle.costaatt.edu.tt
MOODLE_INTEGRATION_MODE=iframe
PILOT_MODE=pilot
STORAGE_ADAPTER=local

# Hosted admin protection. Generate different random values of 32+ characters.
PROTECT_ADMIN_ROUTES=true
ADMIN_ACCESS_TOKEN=replace_with_random_value_at_least_32_characters
ADMIN_SESSION_SECRET=replace_with_a_different_random_value_32_characters

# Choose one provider: openai, deepseek, or ollama
AI_PROVIDER=openai
OPENAI_API_KEY=replace_with_secure_secret
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=replace_with_secure_secret
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
OLLAMA_BASE_URL=http://ollama.internal:11434
OLLAMA_MODEL=llama3.1
PROVIDER_TIMEOUT_MS=30000
PROVIDER_MAX_OUTPUT_TOKENS=900

# Per-process limits. IIS must replace untrusted forwarding headers.
TRUST_PROXY_HEADERS=true
CHAT_RATE_LIMIT_PER_MINUTE=12
FEEDBACK_RATE_LIMIT_PER_MINUTE=30
LAUNCH_AUDIT_RATE_LIMIT_PER_MINUTE=60
PROVIDER_TEST_RATE_LIMIT_PER_MINUTE=6
HEALTH_DETAILS_PUBLIC=false

# Future LTI 1.3 platform values. Keep iframe mode until LTI is approved.
LTI_PLATFORM_ISSUER=https://moodle.costaatt.edu.tt
LTI_CLIENT_ID=replace_with_moodle_client_id
LTI_DEPLOYMENT_ID=replace_with_moodle_deployment_id
LTI_PLATFORM_AUTH_URL=https://moodle.costaatt.edu.tt/mod/lti/auth.php
LTI_PLATFORM_TOKEN_URL=https://moodle.costaatt.edu.tt/mod/lti/token.php
LTI_PLATFORM_JWKS_URL=https://moodle.costaatt.edu.tt/mod/lti/certs.php

KNOWLEDGE_BASE_REVIEWED=false
