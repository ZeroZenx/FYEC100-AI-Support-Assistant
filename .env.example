# Application and Moodle pilot
NEXT_PUBLIC_APP_BASE_URL=http://localhost:4100
MOODLE_ORIGIN=https://moodle.example.edu
MOODLE_INTEGRATION_MODE=iframe
PILOT_MODE=demo
STORAGE_ADAPTER=local

# AI provider: openai, deepseek, or ollama
AI_PROVIDER=openai
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
PROVIDER_TIMEOUT_MS=30000
PROVIDER_MAX_OUTPUT_TOKENS=900

# Admin access. Use different random values of at least 32 characters in hosting.
PROTECT_ADMIN_ROUTES=false
ADMIN_ACCESS_TOKEN=replace_with_random_value_at_least_32_characters
ADMIN_SESSION_SECRET=replace_with_a_different_random_value_32_characters

# Pilot API limits. These are per application process.
CHAT_RATE_LIMIT_PER_MINUTE=12
FEEDBACK_RATE_LIMIT_PER_MINUTE=30
LAUNCH_AUDIT_RATE_LIMIT_PER_MINUTE=60
PROVIDER_TEST_RATE_LIMIT_PER_MINUTE=6

# Public health output is intentionally minimal in production.
HEALTH_DETAILS_PUBLIC=false
TRUST_PROXY_HEADERS=false

# Future LTI 1.3 values. Leave iframe mode selected until LTI validation is approved.
LTI_PLATFORM_ISSUER=https://moodle.example.edu
LTI_CLIENT_ID=your_lti_client_id
LTI_DEPLOYMENT_ID=your_lti_deployment_id
LTI_PLATFORM_AUTH_URL=https://moodle.example.edu/mod/lti/auth.php
LTI_PLATFORM_TOKEN_URL=https://moodle.example.edu/mod/lti/token.php
LTI_PLATFORM_JWKS_URL=https://moodle.example.edu/mod/lti/certs.php

# Legacy review flag; Phase 2 also uses data/knowledge-base-review.json.
KNOWLEDGE_BASE_REVIEWED=false
